.page-shell,
.game-view,
.status-view {
  width: 100%;
  height: 100%;
}

.page-shell {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  background: #05090a;
}

.game-view {
  display: block;
}

.status-view {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 36rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  padding-right: calc(36rpx + env(safe-area-inset-right));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  padding-left: calc(36rpx + env(safe-area-inset-left));
  background: #05090a;
}

.status-panel {
  width: 72vw;
  max-width: 560rpx;
  text-align: center;
}

.status-title {
  color: #f4f7f8;
  font-size: 30rpx;
  line-height: 1.5;
}

.retry-button {
  width: 240rpx;
  height: 76rpx;
  margin-top: 30rpx;
  border: 1rpx solid #6c7880;
  border-radius: 6rpx;
  background: #216b4c;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 74rpx;
}

.retry-button::after {
  border: 0;
}

.retry-button--pressed {
  background: #18543b;
}
